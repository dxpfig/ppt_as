# Copy to .env. Never commit credentials. Existing process environment takes priority.
# Provider: anthropic or openai. Leave commented to use existing environment.
# PPT_LLM_PROVIDER=anthropic
# PPT_LLM_MODEL=your-model-name
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_AUTH_TOKEN=your-bearer-token
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=your-model-name

# Optional long-generation profile for a verified local Qwen/vLLM endpoint.
# Defaults: non-streaming (except official MiniMax auto), 180 seconds, 16000 tokens.
# Timeout bounds both HTTP reads and the complete PPTD model request.
# PPT_LLM_STREAM=true
# PPT_LLM_TIMEOUT_SECONDS=600
# PPT_LLM_MAX_TOKENS=32000
# Provider-specific JSON extensions; only use parameters supported by your server.
# PPT_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Discover limits for the selected model at the start of every job (default auto).
# auto: provider metadata; configured: explicit budget; off: provider defaults.
# auto also detects same-origin Responses input-token counting when vLLM's
# tokenizer is absent. Unsupported counters retain a labelled UTF-8 upper bound.
# PPT_LLM_CONTEXT_MODE=auto
# Optional ceiling in auto mode, or budget for endpoints without metadata.
# Without metadata or this setting, 128000 is an unverified fallback budget.
# PPT_LLM_CONTEXT_TOKENS=128000
# Safety ceiling; automatically reduced to at most 1/32 of the detected window.
# PPT_LLM_CONTEXT_MARGIN=8192
# Reference text budget. The DOCX/ZIP file itself may be up to 50 MB; parsed
# text is capped from the selected model's available context window.
# PPT_REFERENCE_FILE_MAX_BYTES=52428800
# PPT_REFERENCE_MAX_CHARACTERS=2000000
# PPT_REFERENCE_CHARS_PER_TOKEN=2
# Long references use deterministic, lossless paragraph excerpts by default.
# This avoids asking the model to re-emit long Chinese strings as JSON. Enable
# model-selected excerpts only if the endpoint reliably supports strict JSON.
# PPT_MATERIAL_LLM_EXCERPTS=0
# Concurrent page requests stay low by default because official MiniMax-M3 can
# return HTTP 529 under burst load. Increase only if the provider has headroom.
# PPTD_PAGE_CONCURRENCY=2
# Upstream 429/5xx retries: six attempts by default with 1/2/4/8/16-second
# backoff. Completed pages remain checkpointed throughout.
# PPT_LLM_TRANSIENT_RETRIES=5
# Optional same-origin tokenizer URL. Detected vLLM needs no explicit URL.
# PPT_LLM_TOKENIZER_URL=http://localhost:8000/tokenize
# Whole generation phase including all pages/retries; default 1800 seconds.
# PPTD_GENERATION_TIMEOUT_SECONDS=7200

# Kimi expert uses the complete original tool-driven workflow by default. Set
# this to 0 only for the coordinated per-page fallback used with providers that
# cannot sustain the longer ReAct loop.
# PPT_KIMI_AGENTIC=1
# Native Kimi work has two separate phases. Planning first reads the complete
# source outline and writes a full deck plan without creating any page. The host
# validates chapter coverage and minimum page count before page writing starts.
# Page-writing batches are capped at five pages and later batches write at least
# two pages. The page cap must never be applied to the full deck plan.
# The compact planning phase may need to read the outline and targeted source
# chapters, but it never writes pages. Twenty-four ReAct steps avoids treating
# the former 12-step limit as a plan-content limit.
# PPT_KIMI_PLAN_ITERS=24
# PPT_KIMI_PLAN_ATTEMPTS=3
# PPT_KIMI_BATCH_PAGES=2
# PPT_KIMI_BATCH_ITERS=18
# PPT_KIMI_BATCHES=8
# PPT_KIMI_REPAIR_ROUNDS=2
# PPT_KIMI_LAYOUT_PAGE_ATTEMPTS=3
# PPT_KIMI_LAYOUT_PAGE_BATCH=4
# PPT_KIMI_LAYOUT_REPAIR_ROUNDS=3
# Full-resolution visual review is enabled by default (0 disables the gate).
# PPT_KIMI_VISUAL_REVIEW=1
# Per-page repair, visual review and redesign job budget in seconds.
# PPTD_PAGE_ACTION_TIMEOUT_SECONDS=1800
# Body-page background override. When unset, tmp/background.png (or the legacy
# misspelling tmp/backgound.png) is used if present.
# PPT_BACKGROUND_IMAGE=/absolute/path/to/background.png
# Visual repair requests are split by page to stay inside the model context.
# PPTD_VISUAL_REPAIR_PAGE_BATCH=4
# Page-level visual review concurrency; bounded to 1–6.
# PPTD_VISUAL_REVIEW_CONCURRENCY=2
# Page render cache keyed by page, theme, media and renderer version.
# PPT_RENDER_CACHE=1
# PPT_RENDER_CACHE_VERSION=1
# Page-level visual review cache keyed by image, rules and model.
# PPT_REVIEW_CACHE_VERSION=1
# Delivery export cache keyed by document, media and renderer versions.
# PPT_EXPORT_CACHE=1
# PPT_EXPORT_CACHE_VERSION=1
# Deterministic export guards: compatibility migration is always applied once;
# measured overflows may be auto-scaled this many times before AI repair/error.
# PPTD_LAYOUT_AUTOFIT_BUDGET=2
# PPTD_RENDER_REPAIR_BUDGET=4
# Whole native-agent task budget. Long, batched decks can take longer than the
# deterministic route; 90 minutes prevents an otherwise valid final review from
# being cancelled by the old 30-minute ceiling.
# PPT_KIMI_TIMEOUT_SECONDS=5400

# Mandatory fully automatic visual review. Unset values use the same provider's
# generation configuration. This endpoint MUST support actual image input;
# every review runs a pixel challenge before inspecting the entire deck + pages.
# Different vision credentials remain server-side; never enter them in frontend.
# PPT_VISION_PROVIDER=openai
# PPT_VISION_MODEL=your-vision-model
# PPT_VISION_BASE_URL=https://api.example.com/v1
# PPT_VISION_API_KEY=your-vision-api-key
# 可选扩展参数；未填写且服务/模型与生成相同时继承 PPT_LLM_EXTRA_BODY
# PPT_VISION_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Reserved local services: saved configuration only, not yet called by the PPT
# application. These do not change WeKnora settings. URLs are full endpoints.
# PPT_EMBEDDING_URL=http://localhost:8001/v1/embeddings
# PPT_EMBEDDING_MODEL=qwen3-vl-embedding
# PPT_EMBEDDING_API_KEY=your-api-key
# PPT_RERANK_URL=http://localhost:8002/score
# PPT_RERANK_MODEL=qwen3-vl-reranker
# PPT_RERANK_API_KEY=your-api-key
# PPT_OCR_URL=http://localhost:8118/v1/chat/completions
# PPT_OCR_MODEL=PaddleOCR-VL-1.5
# PPT_OCR_API_KEY=your-api-key

# Uses system LibreOffice first, then this locally installed Docker image.
# LIBREOFFICE_BIN=libreoffice
# PPT_RENDERER_IMAGE=wechatopenai/weknora-docreader:latest
# STUDIO_DATA_DIR=/absolute/path/to/runtime/studio

# AgentScope Studio OTLP HTTP backend, NOT the frontend /tracing page.
# Leave unset to disable telemetry. Reports prompts, replies, latency and token usage.
# AGENTSCOPE_STUDIO_URL=http://192.168.0.10:3001

# Slide illustration. Secrets are read only by the Python service.
# WeKnora URL accepts origin or /api/v1. Platform keys also require a tenant ID.
# WEKNORA_BASE_URL=http://192.168.0.10
# WEKNORA_API_KEY=your-weknora-key
# WEKNORA_TENANT_ID=your-workspace-id
# Optional comma-separated KB IDs; otherwise query all accessible KBs in this workspace.
# WEKNORA_KNOWLEDGE_BASE_IDS=
# Configured providers are tried in order. Unconfigured adapters are skipped.
# PPT_IMAGE_WEB_PROVIDERS=mcp,tavily,serper,searxng,bing,commons
# PPT_WEB_MCP_URL=http://your-mcp-server/mcp
# PPT_WEB_MCP_TRANSPORT=http
# PPT_WEB_MCP_HEADERS={"Authorization":"Bearer your-mcp-key"}
# Optional: automatically discover a search tool when omitted, preferring image search.
# PPT_WEB_MCP_TOOL=image_search
# PPT_WEB_MCP_QUERY_KEY=query
# PPT_WEB_MCP_ARGS={}
# TAVILY_API_KEY=your-tavily-key
# SERPER_API_KEY=your-serper-key
# SearXNG must enable the JSON format and image engines.
# SEARXNG_BASE_URL=http://your-searxng-server:8080
# Explicit extra hosts for internal image storage (no credentials forwarded).
# PPT_IMAGE_ALLOWED_HOSTS=minio.company.local
