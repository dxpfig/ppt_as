# Copy the required values into the project .env to use the local Qwen profile.
# Replace the key if the local vLLM gateway does not accept the placeholder.
PPT_LLM_PROVIDER=openai
PPT_LLM_MODEL=Qwen3.8-27B
OPENAI_BASE_URL=http://192.168.0.11:8000/v1
OPENAI_MODEL=Qwen3.8-27B
OPENAI_API_KEY=local-qwen-key

PPT_VISION_PROVIDER=openai
PPT_VISION_MODEL=Qwen3.8-27B
PPT_VISION_BASE_URL=http://192.168.0.11:8000/v1
PPT_VISION_API_KEY=local-qwen-key

PPT_LLM_CONTEXT_MODE=auto
PPT_LLM_CONTEXT_MARGIN=8192
PPT_LLM_MAX_TOKENS=32000
PPT_LLM_STREAM=true
PPT_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Local inference is shared by planning, page writing and visual review.
PPTD_PAGE_CONCURRENCY=2
PPT_KIMI_BATCH_PAGES=2
PPTD_PAGE_ACTION_TIMEOUT_SECONDS=1800
