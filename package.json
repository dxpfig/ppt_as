{
	"name": "agentscope-web-ui",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev:frontend": "pnpm --filter frontend dev",
		"dev:backend": "pnpm --filter backend dev",
		"dev:agent": ".venv/bin/python -m uvicorn agent_service.app:app --host 127.0.0.1 --port 8001",
		"dev": "concurrently --kill-others \"pnpm dev:frontend\" \"pnpm dev:backend\" \"pnpm dev:agent\"",
		"build:frontend": "pnpm --filter frontend build",
		"build:backend": "pnpm --filter backend build",
		"build": "pnpm build:pptd && pnpm build:frontend && pnpm build:backend",
		"format": "prettier --write . && pnpm --filter frontend lint:fix",
		"format:check": "prettier --check . && pnpm --filter frontend lint",
		"prepare": "husky",
		"build:pptd": "pnpm --filter @ppt-as/pptd-runtime build",
		"dev:pptd": "pnpm build:pptd && .venv/bin/python experiments/pptd-v2/server.py --input experiments/pptd-v2/advanced-fixture/advanced.pptd --workspace runtime/pptd-workspace --host 0.0.0.0 --port 8891",
		"test:pptd": "pnpm --filter @ppt-as/pptd-runtime test && .venv/bin/python -m unittest discover -s pptd_engine/tests",
		"test:studio": ".venv/bin/python -m unittest agent_service.test_pptd_store agent_service.test_pptd_exports agent_service.test_pptd_generation agent_service.test_generation_events agent_service.test_model_context agent_service.test_generation_context agent_service.test_pptd_jobs agent_service.test_research agent_service.test_work_history agent_service.test_visual_review agent_service.test_visual_repair agent_service.test_visual_completion agent_service.test_visual_pipeline agent_service.test_kimi_agent"
	},
	"lint-staged": {
		"frontend/**/*.{ts,tsx}": [
			"prettier --write",
			"node scripts/eslint-staged.cjs"
		],
		"backend/**/*.{ts,js}": [
			"prettier --write"
		],
		"*.{json,css,md,html,yaml,yml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"concurrently": "^8.2.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3",
		"playwright": "1.62.1"
	}
}
